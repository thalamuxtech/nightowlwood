rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    /*
     * Staff, read from a custom claim on the token.
     *
     * Storage rules cannot read Firestore, so the `users/{uid}` lookup every other rule in this
     * system uses is unavailable here. A claim is the one thing these rules *can* see, and
     * `syncStaffClaim` in functions/src/staffClaims.ts keeps it mirrored to the user document —
     * set when the account is active with a role, revoked when it is deactivated or deleted.
     *
     * A signed-in session is emphatically **not** the bar. Public signup is enabled on this project,
     * so `request.auth != null` would let any stranger who registers an email address overwrite the
     * images on the live public website and read customers' cutting lists. It is not enough that
     * download URLs carry a token: a principal who satisfies the rule can fetch by path through the
     * SDK, and the paths here are `folder/timestamp-filename` with predictable filenames.
     *
     * `bootstrapEmails` covers the very first sign-in, before any trigger has run.
     */
    function bootstrapEmails() {
      return ['admin@nightowl.com.ng', 'info@nightowl.com.ng'];
    }

    function isStaff() {
      return request.auth != null
        && (request.auth.token.staff == true
            || request.auth.token.email in bootstrapEmails());
    }

    function validImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Work gallery images: public read, staff-only write, images only, max 10 MB.
    match /work/{file} {
      allow read: if true;
      allow write: if isStaff() && validImage();
    }

    // Blog post images: public read, staff-only write.
    match /blog/{file} {
      allow read: if true;
      allow write: if isStaff() && validImage();
    }

    /*
     * Supporting documents on a record.
     *
     * Invoice attachments — the brief's "mostly cutting list document... to prevent loss of customer
     * cutting list document" — and project reference images. Read is staff-only rather than public,
     * unlike the gallery above: a customer's cutting list carries their measurements and is nobody
     * else's business.
     *
     * PDFs are allowed as well as images, because a cutting list arrives as either a photograph or a
     * scan. Deleting is refused: a file removed from a record may be the customer's only copy, and
     * the Firestore side already unlinks it — see the note in FileAttachments.
     */
    function validAttachment() {
      return request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }

    match /invoices/{file} {
      allow read: if isStaff();
      allow write: if isStaff() && validAttachment();
      allow delete: if false;
    }

    match /projects/{file} {
      allow read: if isStaff();
      allow write: if isStaff() && validAttachment();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
