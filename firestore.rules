rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Identity & roles
    // =====================================================================
    //
    // Public signup is enabled on this project, so a signed-in session is NOT
    // proof of staff. Authority comes from `users/{uid}`: the document must
    // exist, be active, and carry a role. `bootstrapAdmin()` covers the very
    // first sign-in, before any user document exists.
    //
    // Capability names mirror src/lib/erp/permissions.ts. The UI hides what a
    // role can't do; these rules are what actually enforce it.

    function bootstrapEmails() {
      return ['admin@nightowl.com.ng', 'info@nightowl.com.ng'];
    }

    function bootstrapAdmin() {
      return request.auth != null && request.auth.token.email in bootstrapEmails();
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.active == true;
    }

    function roleIs(r) {
      return isStaff() && userDoc().data.role == r;
    }

    function isAdmin() {
      return roleIs('admin') || bootstrapAdmin();
    }

    function isManager() {
      return roleIs('manager');
    }

    function isOperator() {
      return roleIs('operator');
    }

    /** Admin or manager — day-to-day operations. */
    function isOps() {
      return isAdmin() || isManager();
    }

    // ---------------------------------------------------------------------
    // Granted capabilities
    // ---------------------------------------------------------------------
    //
    // An admin can widen a role in Settings → Roles, and those grants have to be
    // honoured here or the checkbox is a lie: the UI would show the button and the
    // database would refuse the write.
    //
    // Two capabilities are never grantable, whatever the saved list says.
    // `user.manage` and `settings.change` are the two that can take away an
    // admin's own access — one by editing roles, the other by editing this very
    // document — so granting either is one mistake away from a system nobody can
    // administer. Everything else is the admin's to give.
    //
    // Costs one extra document read per rule evaluation that uses it, cached
    // within a single request.

    function grantsDoc() {
      return get(/databases/$(database)/documents/settings/rolePermissions);
    }

    function ungrantable() {
      return ['user.manage', 'settings.change'];
    }

    /**
     * The role's capabilities when an admin has not customised them.
     *
     * Mirrors MANAGER_CAPABILITIES and OPERATOR_CAPABILITIES in
     * src/lib/erp/permissions.ts, and must be kept in step with them. Without this
     * the two halves disagreed on a fresh project: no grants document meant the
     * client fell back to the code defaults and showed a manager their screens,
     * while the rules denied every read behind them.
     */
    function defaultCaps(role) {
      return role == 'manager'
        ? ['dashboard.view.ops', 'job.view', 'job.create', 'job.edit',
           'job.advanceStatus', 'job.recordPayment', 'worklog.viewAll',
           'worklog.viewOwn', 'worklog.create', 'project.view', 'project.create',
           'project.edit', 'estimate.view', 'estimate.create', 'estimate.edit',
           'estimate.sendForReview', 'inventory.view', 'inventory.edit',
           'tool.request', 'tool.issue', 'supplier.view', 'supplier.edit',
           'purchase.view', 'purchase.create', 'purchase.receive',
           'customer.view', 'staff.view',
           // The counter is the manager's job; voiding a completed sale is not.
           'sale.view', 'sale.create',
           // Observed on the floor, and it only proposes the reduction — the run
           // that applies it still needs wage.approve.
           'deduction.create',
           // Marketing in full: floor work that moves no money, and running the marketers
           // is the manager's job rather than the admin's.
           'marketing.view', 'marketing.record', 'marketing.manage',
           // Asking to delete or change something, never deciding it. A manager needs a
           // working delete button; approval.decide stays with the admin.
           'approval.request']
        : role == 'operator'
          ? ['worklog.viewOwn', 'worklog.create']
          : [];
    }

    /** True when a saved override exists for the caller's role. */
    function hasOverride() {
      return exists(/databases/$(database)/documents/settings/rolePermissions)
        && userDoc().data.role in grantsDoc().data.roles;
    }

    /**
     * True when the caller's role holds `capability`.
     *
     * An admin's saved list replaces the default outright rather than adding to it,
     * matching the client: unticking a box in Settings has to take the permission
     * away, so an override cannot fall back to the default it was meant to narrow.
     */
    function granted(capability) {
      return isStaff()
        && !(capability in ungrantable())
        && (hasOverride()
              ? capability in grantsDoc().data.roles[userDoc().data.role]
              : capability in defaultCaps(userDoc().data.role));
    }

    /** Admin, or a role that holds this capability by default or by grant. */
    function isAdminOr(capability) {
      return isAdmin() || granted(capability);
    }

    /** The staff record linked to the caller, or '' when unlinked. */
    function myStaffId() {
      return isStaff() && 'staffId' in userDoc().data ? userDoc().data.staffId : '';
    }

    // =====================================================================
    // Validation helpers
    // =====================================================================

    function validSubmission(required) {
      return request.resource.data.keys().hasAll(required.concat(['status', 'createdAt']))
        && request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 5000;
    }

    /** True when the update leaves every field in `locked` untouched. */
    function fieldsUnchanged(locked) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(locked);
    }

    // =====================================================================
    // Public website collections (unchanged behaviour)
    // =====================================================================

    match /inquiries/{id} {
      allow create: if validSubmission(['name', 'email', 'message']);
      allow read, update: if isOps();
      allow delete: if isAdminOr('record.delete');
    }

    match /internApplications/{id} {
      allow create: if validSubmission(['name', 'email', 'message', 'area']);
      allow read, update: if isOps();
      allow delete: if isAdminOr('record.delete');
    }

    match /contacts/{id} {
      allow create: if validSubmission(['name', 'email', 'message']);
      allow read, update: if isOps();
      allow delete: if isAdminOr('record.delete');
    }

    match /subscribers/{id} {
      allow create: if request.resource.data.keys().hasAll(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320;
      allow read, update: if isOps();
      allow delete: if isAdminOr('record.delete');
    }

    match /posts/{id} {
      allow read: if resource.data.published == true || isOps();
      allow create, update: if isOps();
      allow delete: if isAdminOr('record.delete');
    }

    match /workItems/{id} {
      allow read: if resource.data.published == true || isOps();
      allow create, update: if isOps();
      allow delete: if isAdminOr('record.delete');
    }

    // =====================================================================
    // Settings
    // =====================================================================
    //
    // Previously world-readable. It now also holds wage rates and the service
    // rate card, so only `public` stays open; everything else is staff-only and
    // admin-writable.

    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    /*
     * The board catalogue, ahead of the general settings rule so it wins.
     *
     * Publicly readable, because it is what the materials section of the website renders from —
     * the same reasoning as `settings/public`. It holds nothing private: display names, one-line
     * descriptions, sheet sizes and image URLs, all of it written to be read by customers.
     *
     * Writing needs `settings.change` like any other settings document — which is on the
     * ungrantable list, so only a real administrator can write here, not a role an admin has
     * widened. `boardCatalogue.ts` restricts the image URL to a path or an http(s) address, and
     * the components that render it re-check the same thing; note that neither is enforced *by
     * this rule*, so the guarantee is "no non-admin can write a bad URL", not "no bad URL can
     * exist in the document".
     */
    match /settings/boardCatalogue {
      allow read: if true;
      allow write: if isAdminOr('settings.change');
    }

    /*
     * Marketing targets, ahead of the general settings rule so it wins.
     *
     * Everything else under `settings` changes how the system computes — tax rates, meter
     * rates, wage defaults — so it is admin-only. This document holds four activity targets
     * for the marketing team, which is a management decision about people rather than a
     * change to any calculation. Requiring an admin for it would mean the person running the
     * marketers cannot set what they are aiming at.
     */
    match /settings/marketing {
      allow read: if isStaff();
      allow write: if isAdminOr('marketing.manage');
    }
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // =====================================================================
    // People
    // =====================================================================

    match /users/{uid} {
      // Anyone signed in may read their own document — that is how the client
      // discovers its role. Ops may read the staff directory.
      allow read: if signedIn() && (request.auth.uid == uid || isOps());

      // Role and active status are the security boundary: admin only.
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && fieldsUnchanged(['role', 'active', 'staffId']));
    }

    match /staff/{id} {
      allow read: if isStaff();
      allow create, update: if isAdminOr('staff.edit');
      allow delete: if isAdminOr('record.delete');

      /*
       * Employment documents: appointment letters, ID cards, certificates.
       *
       * Written with `hr.manage` rather than `staff.edit`, because the two are different
       * jobs: editing a staff record is pay-facing and belongs with whoever runs payroll,
       * while issuing a letter is a personnel matter. Never updated — a document that was
       * issued was issued, and a reprint records a new issue rather than editing the old
       * one, which is what keeps a copy in someone's file matchable to a record.
       */
      match /documents/{docId} {
        allow read: if isStaff();
        allow create: if isAdminOr('hr.manage');
        allow update: if false;
        allow delete: if isAdminOr('record.delete');
      }
    }

    // Failed work-log code attempts, per caller. Written only by the redeem
    // function through the Admin SDK, which bypasses these rules; closing the
    // collection to clients means a caller cannot clear its own lockout, and
    // cannot read the buckets to learn how many codes are being guessed.
    match /accessCodeAttempts/{callerId} {
      allow read, write: if false;
    }

    match /customers/{id} {
      allow read: if isStaff();
      allow create, update: if isOps();
      allow delete: if isAdminOr('record.delete');
    }

    // =====================================================================
    // Services pipeline
    // =====================================================================

    match /serviceJobs/{jobId} {
      allow read: if isAdminOr('job.view');
      allow create, update: if isOps();
      allow delete: if isAdminOr('record.delete');

      match /lines/{lineId} {
        allow read: if isAdminOr('job.view');
        allow write: if isOps();
      }

      // Payments are financial history: recording is fine for ops, but editing
      // or removing a recorded payment is admin-only.
      match /payments/{paymentId} {
        allow read: if isAdminOr('job.view');
        allow create: if isOps();
        allow update, delete: if isAdmin();
      }
    }

    match /workLogs/{id} {
      // Operators see only their own logs; ops see all.
      allow read: if isOps()
        || (isOperator() && resource.data.staffId == myStaffId());

      // An operator may log their own work but cannot attribute it to someone
      // else, which would move wages between people.
      allow create: if isOps()
        || (isOperator() && request.resource.data.staffId == myStaffId());

      allow update: if isOps();
      allow delete: if isAdminOr('record.delete');
    }

    // =====================================================================
    // Products pipeline
    // =====================================================================

    match /projects/{projectId} {
      allow read: if isAdminOr('project.view');
      allow create, update: if isOps();
      allow delete: if isAdminOr('record.delete');

      /*
       * Reference images — photographs a client brought in, a sketch, a room to match.
       *
       * The same grant that edits the project, because attaching the picture the client showed you
       * is part of recording what was asked for rather than a separate act. Deleting only unlinks
       * the record; the file itself stays in Storage, since it may be the only copy.
       */
      match /attachments/{attachmentId} {
        allow read: if isAdminOr('project.view');
        allow create, update: if isOps() || isAdminOr('project.edit');
        allow delete: if isAdminOr('project.edit') || isAdminOr('record.delete');
      }

      match /components/{componentId} {
        allow read: if isAdminOr('project.view');
        allow write: if isOps();

        match /features/{featureId} {
          allow read: if isAdminOr('project.view');
          allow write: if isOps();
        }

        // Bought-in extras — kitchenwares, appliances, fittings. Part of the
        // estimate, so guarded as its line items are.
        match /addons/{addonId} {
          allow read: if isAdminOr('project.view');
          allow write: if isOps();
        }
      }

      /*
       * What was actually bought for the project.
       *
       * Reading needs project access; writing needs the expense grant, because saving
       * one also books an expense. Without that alignment the purchase would be
       * written and the paired expense refused, leaving a project cost that never
       * reached the company books — which silently overstates profit.
       */
      match /purchases/{purchaseId} {
        allow read: if isAdminOr('project.view');
        allow create, update: if isAdminOr('expense.create');
        allow delete: if isAdminOr('record.delete') || isAdminOr('expense.create');
      }
    }

    // The estimate is no longer its own document: a project's components and their
    // ticked features are the line items, and the rates, review token and approval
    // live on the project. These rules stay only so estimates written under the old
    // model remain readable; nothing creates them any more.
    //
    // Reviewer edits arrive through a Cloud Function using the Admin SDK, which
    // bypasses these rules; external reviewers never hold a Firebase session, so no
    // client path is opened for them anywhere.
    match /estimates/{estimateId} {
      allow read: if isAdminOr('project.view');
      allow create, update: if false;
      allow delete: if isAdminOr('record.delete');

      match /lines/{lineId} {
        allow read: if isAdminOr('project.view');
        allow write: if false;
      }
    }

    match /estimateTemplates/{id} {
      allow read: if isAdminOr('project.view');
      allow write: if isAdmin();
    }

    // =====================================================================
    // Money
    // =====================================================================

    // Read gated on the capability, not merely on being ops. A manager without
    // invoice.view could previously fetch the whole ledger by URL, because the
    // rules were looser than the matrix the UI claimed to enforce.
    match /invoices/{id} {
      allow read: if isAdminOr('invoice.view');
      allow create: if isAdminOr('invoice.create');

      /*
       * Four tiers of update, narrowest first.
       *
       * `invoice.markPaid` is the settling grant — the single most abusable action in
       * the system — and it alone may set `paidAt`/`paidBy`.
       *
       * `invoice.void` cancels a document already issued. It changes `status`, so it
       * cannot go through the ordinary editing path, but it must not imply the ability
       * to mark something paid either: voiding writes off a debt while settling claims
       * it was collected, and those are different powers.
       *
       * `job.recordPayment` takes money in. That is ordinary counter work — a customer
       * paying a deposit — so it may move `amountPaidKobo`, `balanceKobo` and the
       * `partial` status, but never the paid stamps, which is what keeps "part paid"
       * and "settled" separable. `recordInvoicePayment` enforces the same split in
       * code, and the rule is what makes it true regardless of the client.
       *
       * Everything else — lines, tax, commission, discount, issuing a draft — is
       * billing work for whoever holds invoice.create or invoice.edit, with the money
       * fields held back.
       */
      allow update: if isAdminOr('invoice.markPaid')
        || isAdminOr('invoice.void')
        || (isAdminOr('job.recordPayment')
            && fieldsUnchanged(['paidAt', 'paidBy', 'lines', 'subtotalKobo', 'totalKobo',
                                'taxKobo', 'commissionKobo', 'discountKobo']))
        || ((isAdminOr('invoice.create') || isAdminOr('invoice.edit'))
            && fieldsUnchanged(['paidAt', 'paidBy', 'amountPaidKobo']));

      allow delete: if isAdminOr('record.delete');

      /*
       * Supporting files — most often the customer's cutting list.
       *
       * Attached with the same grant that creates or edits an invoice, because attaching
       * the cutting list is part of raising the document rather than a separate act. The
       * whole point is that the customer's own paper stops getting lost, so read is as wide
       * as invoice read.
       */
      match /attachments/{attachmentId} {
        allow read: if isAdminOr('invoice.view');
        allow create, update: if isAdminOr('invoice.create') || isAdminOr('invoice.edit');
        allow delete: if isAdminOr('record.delete') || isAdminOr('invoice.edit');
      }
    }

    /*
     * Counter sales.
     *
     * Selling is routine floor work. Voiding a completed sale reverses both the
     * takings and the stock movement after the fact, so it is held separately — and
     * because a void is an update to `status`, the ordinary create grant deliberately
     * cannot perform one.
     */
    match /sales/{saleId} {
      allow read: if isAdminOr('sale.view');
      allow create: if isAdminOr('sale.create');
      /*
       * Two different acts share this one write.
       *
       * Voiding a sale reverses it and needs `sale.void`. Collecting money owed on a credit
       * sale only moves the paid and balance figures, and that is the cashier's daily work —
       * requiring `sale.void` for it would mean either no one can collect a debt or every
       * cashier can cancel a sale. So a payment is allowed with `sale.create` provided it
       * touches nothing but the settlement fields and leaves the total alone.
       */
      allow update: if isAdminOr('sale.void')
        || (isAdminOr('sale.create')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'amountPaidKobo', 'balanceKobo', 'status', 'settledAt',
                 'lastPaymentMethod', 'updatedAt', 'updatedBy'
               ])
            /*
             * A voided sale is finished, and this path must not resurrect it.
             *
             * Voiding leaves `totalKobo` and `amountPaidKobo` intact and zeroes the balance, so
             * without this line every condition below is satisfiable on a voided sale: raise the
             * paid figure by a kobo, recompute the balance, set the status back to `credit`, and
             * the sale is live again — back on the debtors list and back in takings — while the
             * stock the void returned to the shelf stays returned. That is the one thing the
             * `sale.create` branch was written to be incapable of.
             */
            && resource.data.status != 'voided'
            && request.resource.data.status in ['completed', 'credit']
            && request.resource.data.amountPaidKobo is int
            // Defaulted for any sale written before credit existed: those were paid in full,
            // so there is nothing left to collect and the comparison below rejects them.
            && request.resource.data.amountPaidKobo >
                 resource.data.get('amountPaidKobo', resource.data.totalKobo)
            && request.resource.data.amountPaidKobo <= resource.data.totalKobo
            && request.resource.data.balanceKobo ==
                 resource.data.totalKobo - request.resource.data.amountPaidKobo
            /*
             * `settledAt` says when the debt was cleared, so it is either the server's clock or
             * nothing. Left unconstrained a cashier could stamp it with any timestamp, including
             * one backdated into a closed month, which would misplace the money in any report
             * that keys off it. Nothing reads it that way today; this keeps it that way.
             */
            && (request.resource.data.balanceKobo > 0
                  ? request.resource.data.settledAt == null
                  : request.resource.data.settledAt == request.time)
            && request.resource.data.updatedAt == request.time);
      allow delete: if isAdminOr('record.delete');

      match /lines/{lineId} {
        allow read: if isAdminOr('sale.view');
        allow create: if isAdminOr('sale.create');
        allow update, delete: if isAdminOr('record.delete');
      }
    }

    match /expenses/{id} {
      allow read: if isAdminOr('expense.view');
      allow create: if isAdminOr('expense.create');
      allow update: if isAdminOr('expense.create');
      allow delete: if isAdminOr('record.delete');
    }

    match /meterReadings/{id} {
      allow read: if isAdminOr('expense.view');
      allow create: if isAdminOr('expense.create');
      allow update: if isAdminOr('expense.create');
      allow delete: if isAdminOr('record.delete');
    }

    // =====================================================================
    // Payroll — admin by default, grantable
    // =====================================================================
    //
    // A run states what a person is paid, so none of this is open to a role by
    // default. It is all grantable, though: a workshop large enough to have a
    // payroll clerk should not have to make that person an administrator.

    match /wageRates/{id} {
      allow read: if isAdminOr('wage.viewRates') || isAdminOr('wage.run');
      allow write: if isAdminOr('wage.editRates');
    }

    /*
     * Per-person rate overrides.
     *
     * Guarded exactly as the work-type rates are, because they do the same job: they
     * decide what somebody is paid. Kept readable by whoever can generate a run, since
     * a run that cannot read them would silently price everyone at the standard rate
     * and underpay the people on an override.
     */
    match /staffRates/{id} {
      allow read: if isAdminOr('wage.viewRates') || isAdminOr('wage.run');
      allow write: if isAdminOr('wage.editRates');
    }

    /*
     * Pay deductions raised at the work log.
     *
     * Creating one is floor work: a no-show or a breakage is observed by whoever was
     * there, and a deduction nobody can record until an admin is free is one that gets
     * forgotten. It only ever *proposes* a reduction — the run that applies it still
     * needs wage.approve.
     *
     * Updates are the run claiming or releasing a deduction, so they follow the run
     * grants rather than the create grant. Someone who can raise a deduction must not
     * be able to quietly mark their own as already applied.
     */
    match /deductions/{id} {
      allow read: if isAdminOr('deduction.create')
        || isAdminOr('wage.run')
        || isAdminOr('wage.approve');
      allow create: if isAdminOr('deduction.create');
      allow update: if isAdminOr('wage.run') || isAdminOr('wage.approve');
      allow delete: if isAdminOr('record.delete');
    }

    match /wageRuns/{runId} {
      allow read: if isAdminOr('wage.run') || isAdminOr('wage.approve');
      allow write: if isAdminOr('wage.run') || isAdminOr('wage.approve');

      match /lines/{lineId} {
        allow read: if isAdminOr('wage.run') || isAdminOr('wage.approve');
        allow write: if isAdminOr('wage.run') || isAdminOr('wage.approve');
      }
    }

    // Monthly salaries, on the same footing as wage runs. Lines live on the
    // document itself rather than in a subcollection, because there is one row
    // per salaried employee.
    match /salaryRuns/{runId} {
      allow read: if isAdminOr('wage.run') || isAdminOr('wage.approve');
      allow write: if isAdminOr('wage.run') || isAdminOr('wage.approve');
    }

    match /loans/{loanId} {
      // A staff member may always see their own loans, granted or not.
      allow read: if isAdminOr('loan.approve')
        || (isStaff() && resource.data.staffId == myStaffId());

      // Anyone on staff may request; the request must be for themselves and
      // must start in the `requested` state.
      allow create: if isAdminOr('loan.approve')
        || (isStaff()
            && request.resource.data.staffId == myStaffId()
            && request.resource.data.status == 'requested');

      allow update: if isAdminOr('loan.approve');
      allow delete: if isAdminOr('record.delete');

      match /repayments/{repaymentId} {
        allow read, write: if isAdminOr('loan.approve');
      }
    }

    // =====================================================================
    // Inventory
    // =====================================================================

    match /inventoryService/{id} {
      allow read: if isAdminOr('inventory.view');
      allow create, update: if isOps();
      allow delete: if isAdminOr('record.delete');
    }

    /*
     * Company stock.
     *
     * `sale.create` writes here as well as `inventory.edit`, because completing a
     * counter sale decrements the stock it sold in the same transaction. Without that
     * grant a cashier on a role holding sale.create but not inventory.edit would have
     * every sale refused by the rules — the sale document and the stock decrement are
     * one atomic write, so a partial permission fails the whole thing.
     *
     * Read is widened for the same reason: the till has to list what is sellable and
     * check what is on hand before taking money.
     */
    match /inventoryCompany/{itemId} {
      allow read: if isAdminOr('inventory.view') || isAdminOr('sale.view');
      allow create, update: if isOps()
        || isAdminOr('inventory.edit')
        || isAdminOr('sale.create')
        || isAdminOr('sale.void');
      allow delete: if isAdminOr('record.delete');

      // Movements are an append-only ledger: never edited, never deleted.
      match /movements/{movementId} {
        allow read: if isAdminOr('inventory.view') || isAdminOr('sale.view');
        allow create: if isOps()
          || isAdminOr('inventory.edit')
          || isAdminOr('sale.create')
          || isAdminOr('sale.void');
        allow update, delete: if false;
      }
    }

    match /inventoryProduct/{id} {
      allow read: if isAdminOr('inventory.view');
      allow create, update: if isOps();
      allow delete: if isAdminOr('record.delete');
    }

    /*
     * Blade and gum cycles.
     *
     * Readable with `inventory.view` as well as `supplier.view`: the cycle screen sits under stock
     * because that is where a blade is drawn from, and gating it on the procurement grant alone
     * meant whoever manages stock could open the screen and read nothing.
     *
     * Creating one requires `expense.create` and nothing weaker, because issuing a blade *is*
     * spending money: the same batch writes an expense, and `expenses` requires that grant. Allowing
     * `inventory.edit` here would let a manager create the cycle and have the batch fail on the
     * expense — a denial they could do nothing about, reported as a broken button.
     *
     * Updating is wider, because closing a cycle books nothing — but only just wider, and fenced.
     * Whoever manages stock may record that a blade came off the machine and nothing else: the
     * `inventory.edit` path can touch only the closing fields.
     *
     * The fence matters because `costKobo`, `startKey` and `endKey` are the inputs to cost per board
     * and to the window the boards are counted over, while the expense booked at issue is a separate
     * document that does not move. Left unfenced, a stock-only grant could rewrite the cost the
     * cycle reports without touching the money actually recognised — and clearing `endKey` would
     * reopen a closed cycle so that two cycles both claimed the same boards, which is the exact
     * double-count the atomic issue was written to prevent.
     */
    match /consumableCycles/{id} {
      allow read: if isAdminOr('inventory.view') || isAdminOr('supplier.view');
      allow create: if isAdminOr('expense.create');
      allow update: if isAdminOr('expense.create')
        || (isAdminOr('inventory.edit')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'endKey', 'endAt', 'closeReason', 'closedByCycleId', 'updatedAt', 'updatedBy'
               ])
            // A cycle already closed stays closed: reopening it would let two cycles claim the
            // same boards.
            && resource.data.endKey == null);
      allow delete: if isAdminOr('record.delete');
    }

    // =====================================================================
    // Procurement
    // =====================================================================

    match /suppliers/{id} {
      allow read: if isAdminOr('supplier.view');
      allow create, update: if isOps();
      allow delete: if isAdminOr('record.delete');
    }

    match /consumableBrands/{id} {
      allow read: if isAdminOr('supplier.view');
      allow create, update: if isOps();
      allow delete: if isAdminOr('record.delete');
    }

    match /purchases/{purchaseId} {
      allow read: if isOps();
      allow create, update: if isOps();
      allow delete: if isAdminOr('record.delete');

      match /lines/{lineId} {
        allow read: if isOps();
        allow write: if isOps();
      }
    }

    // =====================================================================
    // Tools
    // =====================================================================

    match /toolRequests/{requestId} {
      // Anyone with tool.request may see the log; a staff member may always see a
      // request raised in their own name, granted or not, because it is theirs.
      allow read: if isAdminOr('tool.request')
        || (isStaff() && resource.data.requestedByStaffId == myStaffId());

      allow create: if isAdminOr('tool.request')
        || (isStaff() && request.resource.data.requestedByStaffId == myStaffId());

      allow update: if isAdminOr('tool.issue');
      allow delete: if isAdminOr('record.delete');

      // Items cannot repeat the parent's ownership test — `resource` here is the
      // item, which carries no staff id — so they follow the capability alone. A
      // staff member reading their own request sees the header without the lines
      // unless they hold tool.request, which every role that uses this screen does.
      match /items/{itemId} {
        allow read: if isAdminOr('tool.request');
        allow write: if isAdminOr('tool.issue');
      }
    }

    // =====================================================================
    // System
    // =====================================================================

    // Append-only. No client may update or delete an audit entry — not even an
    // admin — so the trail cannot be rewritten after the fact.
    /*
     * Change requests awaiting a decision.
     *
     * `create` needs `approval.request` — the ability to *ask*. `update` needs
     * `approval.decide`, because deciding is the gate, and letting the requester update
     * their own request would let them mark it approved and defeat the whole workflow.
     *
     * The one exception is withdrawing: `cancelRequest` lets whoever raised a request take
     * it back. That is an update by the requester, so it is allowed only when they are the
     * requester *and* the request is still pending — and it may set nothing but the
     * cancelled state, which `fieldsUnchanged` on the substance enforces.
     *
     * Never deletable. A refused request is the record of a refusal, and being able to
     * remove it would erase exactly the history the queue exists to keep.
     */
    match /approvals/{id} {
      allow read: if isAdminOr('approval.request') || isAdminOr('approval.decide');
      allow create: if isAdminOr('approval.request')
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 3;

      allow update: if isAdminOr('approval.decide')
        || (resource.data.requestedByUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && fieldsUnchanged(['kind', 'targetCollection', 'targetId', 'reason',
                                'payload', 'before', 'requestedByUid']));

      allow delete: if false;
    }

    /*
     * Days the workshop was shut.
     *
     * Readable by any staff member, because a work log screen showing "no entries" needs to
     * be able to say whether that was a holiday. Writing affects how absence is counted in
     * payroll, so it is held separately.
     */
    match /holidays/{id} {
      allow read: if isStaff();
      allow create, update: if isAdminOr('holiday.manage');
      allow delete: if isAdminOr('holiday.manage') || isAdminOr('record.delete');
    }

    /*
     * The counter's own stock.
     *
     * A separate shelf from the workshop's, so the till reads and writes here and nowhere else. Goods
     * arrive by a transfer that moves both sides in one transaction — which is why `sale.create`
     * needs write access to *both* collections: the transfer decrements company stock and increments
     * this, and a grant covering only one half would fail the transaction and lose the goods from the
     * record while they sat physically on the counter.
     *
     * Movements are append-only for the same reason as the workshop's: a stock ledger somebody can
     * edit after the fact cannot be reconciled against a shelf.
     */
    match /inventoryPos/{itemId} {
      allow read: if isAdminOr('sale.view') || isAdminOr('inventory.view');
      allow create, update: if isAdminOr('sale.create')
        || isAdminOr('sale.void')
        || isAdminOr('inventory.edit');
      allow delete: if isAdminOr('record.delete');

      match /movements/{movementId} {
        allow read: if isAdminOr('sale.view') || isAdminOr('inventory.view');
        allow create: if isAdminOr('sale.create')
          || isAdminOr('sale.void')
          || isAdminOr('inventory.edit');
        allow update, delete: if false;
      }
    }

    /*
     * The fixed assets register.
     *
     * Read with `inventory.view`, since it sits in the same group and answers a stock-taking
     * question — what do we own and where is it.
     *
     * Deleting is refused to everyone, including `record.delete`. An asset that was owned and has
     * gone is history the register has to keep: the accounts show depreciation charged against it in
     * previous years, and removing the asset makes those charges unexplainable. `disposeAsset` is the
     * way out, and it records when and why.
     */
    match /fixedAssets/{id} {
      allow read: if isAdminOr('inventory.view');
      allow create, update: if isAdminOr('inventory.edit');
      allow delete: if false;
    }

    /*
     * The attendance register.
     *
     * Readable by anyone who can see staff, because an empty work log needs to be explainable —
     * "was he not in, or did nobody write it down?" is the first question about a light week.
     *
     * Written with `worklog.create`, which is the supervisor on the floor. That is deliberately a
     * lower bar than `staff.edit`: whoever is standing in the workshop at 8am is who knows who
     * turned up, and a register only an admin can fill is one that gets filled from memory on
     * Friday. Marking someone absent takes no money — raising the deduction is a separate act
     * needing `deduction.create` — so the worst a wrong tick does is misstate a day until it is
     * corrected, and every correction is in the audit log.
     *
     * Deleting needs `record.delete` like everything else. A day removed from the register is a
     * day nobody can account for, which is exactly what the register exists to prevent.
     */
    match /attendance/{id} {
      allow read: if isAdminOr('staff.view');

      /*
       * The id must match the fields inside it.
       *
       * `markAttendance` derives the id as `{dateKey}_{staffId}` and that derivation is the only
       * thing stopping two contradictory rows for one person on one day. A document whose id says
       * one person and whose body says another is reachable by one code path and not the other —
       * `loadAttendance` queries the field, `linkAbsenceDeduction` writes to the id — so it must
       * not be writable at all.
       *
       * `deductionId` is the money invariant. Once an absence has been charged, that link is what
       * stops the same day being charged again, so clearing or changing it needs the permission
       * that raises deductions in the first place. Everyone else may correct the status and the
       * note and nothing more.
       */
      allow create: if (isAdminOr('staff.edit') || isAdminOr('worklog.viewAll'))
        && id == request.resource.data.dateKey + '_' + request.resource.data.staffId
        && request.resource.data.status in ['present', 'absent', 'leave', 'holiday']
        && request.resource.data.markedBy == request.auth.uid;

      allow update: if (isAdminOr('staff.edit') || isAdminOr('worklog.viewAll'))
        && id == request.resource.data.dateKey + '_' + request.resource.data.staffId
        && request.resource.data.status in ['present', 'absent', 'leave', 'holiday']
        && request.resource.data.markedBy == request.auth.uid
        // The day and the person a row is about never change; a correction is to the status.
        && request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.staffId == resource.data.staffId
        && (request.resource.data.get('deductionId', null)
              == resource.data.get('deductionId', null)
            || isAdminOr('deduction.create'));

      allow delete: if isAdminOr('record.delete');
    }

    /*
     * Recurring fixed costs.
     *
     * Read alongside the finance dashboard, since the monthly floor is part of reading a
     * profit figure. Written with the expense grant, because recording a payment against
     * one writes an expense.
     */
    match /fixedCosts/{id} {
      allow read: if isAdminOr('expense.view') || isAdminOr('profit.view');
      allow create, update: if isAdminOr('expense.create');
      allow delete: if isAdminOr('record.delete');
    }

    /*
     * Marketing.
     *
     * One shape across all four collections, because they are one module and the split between
     * them is about lifetime rather than about who may touch them:
     *
     * - **read** on `marketing.view` — the office answering a quotation request needs to see the
     *   pipeline without being able to add to it.
     * - **create** on `marketing.record` — the marketer's daily work.
     * - **update** on `marketing.record` too, deliberately. A visit gains a `leadId` when it is
     *   promoted, a lead gains a follow-up count and a next-action date every time it is worked.
     *   Requiring a supervisor for those would mean a marketer cannot log their own follow-up.
     * - **delete** on `record.delete` — the same bar as everywhere else in the system. A mistyped
     *   visit is removed by an admin, and the audit entry keeps what it said.
     *
     * No field validation here beyond the capability, unlike `cuttingLists` above. That rule is
     * strict because it is open to the public; these are staff-only collections holding notes
     * about conversations, with no money, stock or payroll consequence to protect. The
     * validations that matter — a contact needs a phone number, a lost lead needs a reason — are
     * judgements about usefulness rather than about safety, and they live in `marketing.ts`
     * where they can say why.
     */
    match /siteVisits/{id} {
      allow read: if isAdminOr('marketing.view');
      allow create, update: if isAdminOr('marketing.record');
      allow delete: if isAdminOr('record.delete');
    }
    /*
     * Leads, where the record/manage split has to be real.
     *
     * A marketer needs `update` for their daily work: logging a follow-up patches the lead's
     * next-action date and its follow-up count. But calling a lead **won** is a judgement about
     * that marketer's own performance — the weekly summary counts `status == "won"` — so a
     * marketer who could write it would be marking their own homework, and could also clear
     * `nextActionOn` to make an overdue call disappear from the due list.
     *
     * So: `marketing.manage` may write anything, `marketing.record` may write anything except the
     * three closing fields. Mirrors how the invoices block fences off its own status.
     */
    match /leads/{id} {
      allow read: if isAdminOr('marketing.view');
      allow create: if isAdminOr('marketing.record');
      allow update: if isAdminOr('marketing.manage')
        || (isAdminOr('marketing.record')
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['closedAt', 'closeReason'])
            /*
             * Status may move, but only forward through the working states.
             *
             * Logging a follow-up promotes `new` to `contacted`, and raising a quotation request
             * sets `quoted` — both are things a marketer does in the ordinary course of the work,
             * so denying them outright would break the module for a record-only role. What stays
             * out of reach is `won` and `lost`: those are the figures the marketer is judged on.
             */
            && request.resource.data.status in ['new', 'contacted', 'quoted']);
      allow delete: if isAdminOr('record.delete');
    }
    match /followUps/{id} {
      allow read: if isAdminOr('marketing.view');
      allow create, update: if isAdminOr('marketing.record');
      allow delete: if isAdminOr('record.delete');
    }
    match /quoteRequests/{id} {
      allow read: if isAdminOr('marketing.view');
      allow create, update: if isAdminOr('marketing.record');
      allow delete: if isAdminOr('record.delete');
    }

    /*
     * Cutting lists.
     *
     * The one collection a member of the public may write to, and the reasoning is the same as
     * for the enquiry forms above: the customer is the person who knows what they want cut, and
     * the paper list they would otherwise carry in is the document that gets lost.
     *
     * The create rule is tight because it is open. It requires the shape a real submission has —
     * a name, a phone number, at least one part, a `submitted` status and the
     * `submittedByCustomer` marker — and caps the part count so one request cannot write a
     * multi-megabyte document. It cannot set `customerId`, so a stranger cannot attach a list to
     * somebody else's account; staff link it afterwards.
     *
     * Reading is staff-only. A customer gets a reference number on screen and quotes it, rather
     * than a link that would let anyone enumerate other people's lists.
     */
    match /cuttingLists/{id} {
      allow read: if isAdminOr('job.view') || isAdminOr('customer.view');

      allow create: if request.resource.data.keys().hasAll(
                         ['listNumber', 'customerName', 'customerPhone', 'parts',
                          'status', 'submittedByCustomer', 'totals', 'createdAt'])
        /*
         * `hasOnly` as well as `hasAll`, which is the part that matters.
         *
         * `hasAll` is a subset test — it permits any *additional* key. Without this line an
         * anonymous caller could bolt on a 900KB string, or set `createdBy` to a staff uid,
         * or add fields the admin screen renders. The allowed set is the exact shape the
         * builder writes and nothing else.
         */
        && request.resource.data.keys().hasOnly(
             ['listNumber', 'customerName', 'customerPhone', 'customerId',
              'jobId', 'jobNumber', 'title', 'parts', 'wastePercent', 'offsetMm',
              'totals', 'status', 'notes', 'submittedAt', 'submittedByCustomer',
              'createdAt', 'createdBy'])
        && request.resource.data.status == 'submitted'
        /*
         * The reference must look like a public one.
         *
         * Unvalidated, a caller could submit `CL-2026-0001` and wear the shape of a
         * staff-sequenced number — so a customer quoting it at the counter pulls up the
         * wrong list, or an anonymous list is treated as staff-entered and cut without
         * anybody confirming the figures. The pattern is exactly what `publicReference()`
         * produces: CL-YYMMDD-XXXX from an alphabet with no easily-misread characters.
         */
        && request.resource.data.listNumber is string
        && request.resource.data.listNumber.matches('^CL-[0-9]{6}-[A-Z2-9]{4}$')
        // Never false: this marker is what tells staff to confirm the figures before
        // cutting, so a submission cannot suppress it.
        && request.resource.data.submittedByCustomer == true
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 1
        && request.resource.data.customerName.size() < 200
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() > 5
        && request.resource.data.customerPhone.size() < 40
        && request.resource.data.parts is list
        && request.resource.data.parts.size() > 0
        // A cutting list of more than 300 panels is not a cutting list, it is an attack.
        && request.resource.data.parts.size() <= 300
        /*
         * Typed and bounded, so a malformed value cannot be stored and then crash the admin
         * screen when React is handed an object where a string belongs.
         *
         * `totals` cannot be verified here — rules cannot loop over a list to recompute it —
         * so it is only shape-checked. The screens recompute it for customer-submitted lists
         * and flag any divergence, which is where a fabricated figure is actually caught.
         */
        && request.resource.data.totals is map
        && (!('notes' in request.resource.data.keys())
            || request.resource.data.notes == null
            || request.resource.data.notes.size() < 2000)
        && (!('title' in request.resource.data.keys())
            || request.resource.data.title == null
            || request.resource.data.title.size() < 200)
        // Never set by a public submission: staff attach the list to a customer once they
        // have matched it up, and letting the caller choose would attach it to anyone.
        && request.resource.data.customerId == null
        && request.resource.data.jobId == null
        && request.resource.data.createdBy == null;

      // Staff only, once it is in: linking it to a customer, and moving it through production.
      allow update: if isOps() || isAdminOr('job.edit');
      allow delete: if isAdminOr('record.delete');
    }

    match /auditLog/{id} {
      allow read: if isAdminOr('audit.view');
      allow create: if isStaff();
      // Never editable or deletable, by anyone, granted or not. A log that can be
      // rewritten is not a log, and no capability should be able to make it one.
      allow update, delete: if false;
    }

    /*
     * Document-number sequences, allocated in a client transaction.
     *
     * Any staff member who can create a numbered document needs this, so it is gated on
     * being staff rather than on a role. Narrowing it to isOps() meant a granted role —
     * a cashier with sale.create, or a clerk with invoice.create — could pass every
     * other rule and still fail here, at the point where the number is drawn, which
     * fails the whole write for a reason nothing on screen could explain.
     *
     * The exposure is only the ability to advance a counter, which wastes a number in
     * the sequence and nothing more.
     */
    match /counters/{name} {
      allow read, write: if isStaff();
    }

    // Deny everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
